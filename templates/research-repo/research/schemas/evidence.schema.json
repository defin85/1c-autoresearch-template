{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "evidence_id", "target_id", "path", "fingerprint", "source_generation_id", "diff_generation_id"],
  "properties": {
    "schema_version": {"const": "1"},
    "evidence_id": {"type": "string", "minLength": 1},
    "target_id": {"type": "string", "pattern": "^(MRQ|DIF)-[0-9A-F]{16}$"},
    "path": {"type": "string", "minLength": 1},
    "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_generation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "diff_generation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime": {"type": "object"}
  },
  "additionalProperties": false
}
