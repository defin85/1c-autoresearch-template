{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "generation_id", "acquisition_profile_id", "representation_schema", "normalizer_version", "source_contract_sha256", "roles", "components"],
  "properties": {
    "schema_version": {"const": "1"},
    "generation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "acquisition_profile_id": {"type": "string", "pattern": "^(ibcmd|designer)\\+(xml-hierarchical|v8unpack|edt-project)/v1$"},
    "representation_schema": {"enum": ["xml-hierarchical", "v8unpack", "edt-project"]},
    "normalizer_version": {"type": "string", "minLength": 1},
    "source_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "roles": {
      "type": "object",
      "required": ["vendor_baseline", "target_cf", "next_vendor"],
      "properties": {
        "vendor_baseline": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "target_cf": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "next_vendor": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "components": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["component_id", "kind", "path", "fingerprint"], "properties": {"component_id": {"type": "string", "minLength": 1}, "kind": {"enum": ["configuration", "extension", "external"]}, "path": {"type": "string", "minLength": 1}, "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
