{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "batch_id", "mrq_ids", "basis", "anchor_component_ids", "full_fingerprint"],
  "properties": {
    "schema_version": {"const": "1"},
    "batch_id": {"type": "string", "pattern": "^MRQB-[0-9A-F]{16}$"},
    "mrq_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^MRQ-[0-9A-F]{16}$"}
    },
    "basis": {"type": "string", "minLength": 1},
    "anchor_component_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "full_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
