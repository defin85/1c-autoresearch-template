{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "id", "kind", "semantic_key", "filename", "size_bytes", "sha256"],
  "properties": {
    "schema_version": {"const": "1"},
    "id": {"type": "string", "pattern": "^EXT-[0-9A-F]{16}$"},
    "kind": {"enum": ["epf", "erf", "source-tree", "other"]},
    "semantic_key": {"type": "string", "minLength": 1},
    "filename": {"type": "string", "minLength": 1},
    "size_bytes": {"type": "integer", "minimum": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_status": {"enum": ["available", "missing"]}
  },
  "additionalProperties": false
}
