{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "routing_contract_version", "groups", "routing_manifest_fingerprint"],
  "properties": {
    "schema_version": {"const": "2"},
    "routing_contract_version": {"const": "form-routing/v1"},
    "groups": {
      "type": "array",
      "items": {"$ref": "#/$defs/group"}
    },
    "routing_manifest_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["managed", "ordinary", "inconclusive"],
      "properties": {
        "managed": {"type": "integer", "minimum": 0},
        "ordinary": {"type": "integer", "minimum": 0},
        "inconclusive": {"type": "integer", "minimum": 0}
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "component_id"],
      "properties": {
        "role": {"enum": ["vendor_baseline", "target_cf", "next_vendor"]},
        "component_id": {"type": "string", "minLength": 1}
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routing_group_id", "kind", "members", "absent_roles", "probe_contract_version", "probe_fingerprints", "form_counts", "routing_reason", "exporter", "representation_schema", "exporter_version", "converter_version"],
      "properties": {
        "routing_group_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["configuration", "extension", "epf", "erf", "source-tree", "other"]},
        "members": {"type": "array", "items": {"$ref": "#/$defs/member"}},
        "absent_roles": {"type": "array", "uniqueItems": true, "items": {"enum": ["vendor_baseline", "target_cf", "next_vendor"]}},
        "probe_contract_version": {"enum": ["", "form-probe/v1"]},
        "probe_fingerprints": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["component_id", "probe_fingerprint"], "properties": {"component_id": {"type": "string", "minLength": 1}, "probe_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}},
        "form_counts": {"$ref": "#/$defs/counts"},
        "routing_reason": {"enum": ["managed_only", "ordinary_form_present", "inconclusive_form_payload", "no_forms", "binary_container_requires_v8unpack", "declared_source_tree", "raw_artifact"]},
        "exporter": {"enum": ["ibcmd", "designer", "verified-upload"]},
        "representation_schema": {"enum": ["xml-hierarchical/v1", "v8unpack/v1", "source-tree/v1", "raw-binary/v1"]},
        "exporter_version": {"type": "string"},
        "converter_version": {"type": "string"}
      }
    }
  }
}
