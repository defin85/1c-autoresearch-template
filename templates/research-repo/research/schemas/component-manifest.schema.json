{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "name", "version", "representation_schema", "payload_file_count", "payload_fingerprint"],
      "properties": {
        "schema_version": {"const": "1"},
        "kind": {"enum": ["configuration", "extension"]},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string"},
        "representation_schema": {"enum": ["xml-hierarchical", "v8unpack", "edt-project"]},
        "payload_file_count": {"type": "integer", "minimum": 1},
        "payload_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "active": {"type": "boolean"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "configuration"}}}, "then": {"required": ["uuid"]}},
        {"if": {"properties": {"kind": {"const": "extension"}}}, "then": {"required": ["uuid", "active"]}}
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "component_id", "kind", "routing_group_id", "probe_contract_version", "probe_fingerprint", "form_counts", "routing_reason", "exporter", "representation_schema", "exporter_version", "converter_version", "payload_file_count", "payload_fingerprint"],
      "properties": {
        "schema_version": {"const": "2"},
        "component_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["configuration", "extension", "epf", "erf", "source-tree", "other"]},
        "routing_group_id": {"type": "string", "minLength": 1},
        "probe_contract_version": {"enum": ["", "form-probe/v1"]},
        "probe_fingerprint": {"type": "string"},
        "form_counts": {"type": "object", "additionalProperties": false, "required": ["managed", "ordinary", "inconclusive"], "properties": {"managed": {"type": "integer", "minimum": 0}, "ordinary": {"type": "integer", "minimum": 0}, "inconclusive": {"type": "integer", "minimum": 0}}},
        "routing_reason": {"enum": ["managed_only", "ordinary_form_present", "inconclusive_form_payload", "no_forms", "binary_container_requires_v8unpack", "declared_source_tree", "raw_artifact"]},
        "exporter": {"enum": ["ibcmd", "designer", "verified-upload"]},
        "representation_schema": {"enum": ["xml-hierarchical/v1", "v8unpack/v1", "source-tree/v1", "raw-binary/v1"]},
        "exporter_version": {"type": "string"},
        "converter_version": {"type": "string"},
        "payload_file_count": {"type": "integer", "minimum": 1},
        "payload_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  ]
}
